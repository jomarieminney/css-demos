# Netlify cache rules. HTML stays revalidated on every request; the
# stylesheet and assets can be served from cache while revalidating in the
# background, so a repeat navigation renders without waiting on the origin.
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
